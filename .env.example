# ==============================================================================
# AccessAI — Environment Configuration Template
# ==============================================================================
# Copy this file to `.env.local` for local development overrides.
# In Docker or production, pass these variables via docker-compose or container env.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=production

# ------------------------------------------------------------------------------
# 2. SQLite Database Persistence
# ------------------------------------------------------------------------------
# Local development path:
DATABASE_URL=file:./data/accessai.db

# In Docker container (mapped to persistent volume at /app/data):
# DATABASE_URL=file:/app/data/accessai.db

# ------------------------------------------------------------------------------
# 3. Ollama Local AI Remediation
# ------------------------------------------------------------------------------
# In bare-metal local development:
OLLAMA_BASE_URL=http://127.0.0.1:11434

# In Docker container (connecting to Ollama daemon running on host machine):
# OLLAMA_BASE_URL=http://host.docker.internal:11434

OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_MS=25000

# ------------------------------------------------------------------------------
# 4. Scanner Engine Limits & Concurrency
# ------------------------------------------------------------------------------
SCAN_TIMEOUT_MS=25000
MAX_CONCURRENT_SCANS=2
